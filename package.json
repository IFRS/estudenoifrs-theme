{
  "name": "ifrs-estude-theme",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build --watch",
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "analyze": "analyze",
    "lint:js": "eslint src --ext .js",
    "lint:css": "stylelint \"sass/**/*.scss\"",
